# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Design reference dropped in by hand — another project's full source tree,
# kept locally to work from but not ours to commit.
/Levi-Portfolio-main/

# Source screenshots dropped in by hand. The portrait is converted into
# public/images/portrait.jpg, which is what the site actually ships.
/Screenshot*.png
